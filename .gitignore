# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# 虚拟环境（请各自用 python -m venv 重建）
venv/
.venv/
env/

# 用户本地设置与运行时产物（含个人调参，不入库；首次运行会自动生成默认值）
settings.json
# 百度网盘应用凭证与用户令牌（开发环境落在仓库根；含敏感数据，严禁入库）
baidu_netdisk.json

# 操作系统 / 编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/

# WorkBuddy 等本地工作区数据
.workbuddy/

# Everything 运行时数据库（由内置实例在 %LOCALAPPDATA% 生成；vendor 下的副本是测试残留）
vendor/Everything/*.db*

# 未使用 / 冗余素材（有意不入库）
assets/logo2.png
vendor/Everything-x64.zip
